# Copy to .env and fill in.

# Sign-in for the admin interface at /admin (required).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Port the broadcast is published on.
PORT=8080

# Optional: ElevenLabs API key. With it the presenters speak in ElevenLabs voices;
# without it the broadcast uses the browser's own voice.
ELEVENLABS_API_KEY=
